# İlkOku production environment example
# Gerçek kullanıcı adı, parola, token veya secret bu dosyaya yazılmamalıdır.
# Her gizli değer birbirinden farklı ve rastgele üretilmelidir.

# Veritabanı
# Runtime DB_* değerlerini öncelikli kullanır. Prisma migration/build işlemleri için
# DATABASE_URL de güncel tutulmalıdır.
DATABASE_URL="mysql://DB_USER:URL_ENCODED_DB_PASSWORD@DB_HOST:3306/DB_NAME"
DB_HOST="DB_HOST"
DB_PORT="3306"
DB_USER="DB_USER"
DB_PASSWORD="CHANGE_ME"
DB_NAME="DB_NAME"

# Uygulama adresi
NEXT_PUBLIC_SITE_URL="https://ilkoku.com"
SITE_URL="https://ilkoku.com"

# E-posta teslimatı
EMAIL_DELIVERY_MODE="smtp"
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="ilkoku@ilkoku.com"
SMTP_PASSWORD="CHANGE_ME"
MAIL_REPLY_TO="ilkoku@ilkoku.com"

# Production ortamında varsayılan olarak gerçek SMTP kullanıcısı gönderici olur.
# Kanal adresleri sunucuda ayrıca doğrulanmadan true yapılmamalıdır.
MAIL_ALLOW_CHANNEL_SENDERS="false"
MAIL_FROM_DEFAULT="ilkoku@ilkoku.com"
MAIL_FROM_SYSTEM="noreply@ilkoku.com"
MAIL_FROM_SUPPORT="destek@ilkoku.com"
MAIL_FROM_EDITOR="editor@ilkoku.com"
MAIL_FROM_PUBLISHER="yayinevi@ilkoku.com"

# Güvenlik ve zamanlanmış görevler
# İlk iki değer en az 64 karakter, özet secret'ı en az 32 karakter olmalıdır.
ADMIN_ROLE_VIEW_SECRET="CHANGE_ME_WITH_AT_LEAST_64_RANDOM_CHARACTERS"
READING_ACCESS_HASH_SECRET="CHANGE_ME_WITH_AT_LEAST_64_RANDOM_CHARACTERS"
WRITER_DAILY_SUMMARY_SECRET="CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS"

# Bu proje AUTH_SECRET kullanmaz. Oturumlar veritabanındaki Session kayıtlarında
# SHA-256 ile hash'lenen rastgele tokenlarla yönetilir.

# Yalnızca local geliştirme için isteğe bağlı değerler
EMAIL_LOCAL_SITE_URL="http://localhost:3000"
EMAIL_OUTBOX_DIR="/tmp/ilkoku-mail-outbox"

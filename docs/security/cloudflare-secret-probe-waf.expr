(
  lower(http.request.uri.path) contains "/.env" or
  lower(http.request.uri.path) contains "/.docker/" or
  lower(http.request.uri.path) contains "/.git/" or
  lower(http.request.uri.path) contains "/.aws/" or
  lower(http.request.uri.path) eq "/.boto" or
  lower(http.request.uri.path) eq "/server.key" or
  lower(http.request.uri.path) eq "/privatekey.key" or
  lower(http.request.uri.path) eq "/key.pem" or
  lower(http.request.uri.path) eq "/id_ed25519" or
  lower(http.request.uri.path) eq "/secrets.json" or
  lower(http.request.uri.path) eq "/appsettings.development.json" or
  ends_with(lower(http.request.uri.path), ".auto.tfvars")
)

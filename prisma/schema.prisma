  membershipId  String                           @db.Char(36)
  requestedById String                           @db.Char(36)
  permission    String                           @db.VarChar(64)
  status        PublisherPermissionRequestStatus @default(pending)
  pendingKey    String?                          @unique @db.VarChar(140)
  requestNote   String?                          @db.VarChar(500)
  reviewNote    String?                          @db.VarChar(500)
  reviewedById  String?                          @db.Char(36)
  reviewedAt    DateTime?
  createdAt     DateTime                         @default(now())
  updatedAt     DateTime                         @updatedAt
  publisher     Publisher                        @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  membership    PublisherMembership              @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  requestedBy   User                             @relation("PublisherPermissionRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewedBy    User?                            @relation("PublisherPermissionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([publisherId, status, createdAt])
  @@index([membershipId, status, createdAt])
  @@index([requestedById, createdAt])
  @@index([reviewedById, reviewedAt])
  @@index([permission, status])
}


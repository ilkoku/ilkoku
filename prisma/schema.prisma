  requestedBy   User                             @relation("PublisherPermissionRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewedBy    User?                            @relation("PublisherPermissionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([publisherId, status, createdAt])
  @@index([membershipId, status, createdAt])
  @@index([requestedById, createdAt])
  @@index([reviewedById, reviewedAt])
  @@index([permission, status])
}


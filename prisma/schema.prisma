}

model PublishingContract {
  id                 String                   @id @default(uuid()) @db.Char(36)
  submissionId       String                   @unique @db.Char(36)
  createdById        String                   @db.Char(36)
  status             PublishingContractStatus @default(draft)
  version            Int                      @default(1) @db.UnsignedInt
  royaltyPercentage  Decimal                  @db.Decimal(5, 2)
  advanceAmount      Decimal?                 @db.Decimal(12, 2)
  rightsPeriodMonths Int                      @default(60) @db.UnsignedSmallInt
  territory          String                   @default("Türkiye") @db.VarChar(180)
  notes              String?                  @db.Text
  sentAt             DateTime?
  acceptedAt         DateTime?
  rejectedAt         DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  submission         PublisherSubmission      @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  createdBy          User                     @relation("PublishingContractCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([status, updatedAt])
  @@index([createdById, createdAt])
}

model PublicationPlan {
  id                    String                @id @default(uuid()) @db.Char(36)
  submissionId          String                @unique @db.Char(36)
  status                PublicationPlanStatus @default(planning)
  targetPublicationDate DateTime?
  isbn                  String?               @db.VarChar(32)
  coverStatus           ProductionTaskStatus  @default(not_started)
  layoutStatus          ProductionTaskStatus  @default(not_started)
  printRun              Int?                  @db.UnsignedInt
  notes                 String?               @db.Text
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  submission            PublisherSubmission   @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([status, targetPublicationDate])
}

model PublisherSubmissionEvent {
  id           String                       @id @default(uuid()) @db.Char(36)
  submissionId String                       @db.Char(36)
  actorId      String?                      @db.Char(36)
  type         PublisherSubmissionEventType
  title        String                       @db.VarChar(180)
  detail       String?                      @db.Text
  metadata     String?                      @db.LongText
  createdAt    DateTime                     @default(now())
  submission   PublisherSubmission          @relation(fields: [submissionId], references: [id], onDelete: Cascade)

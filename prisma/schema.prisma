generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id                           String                       @id @default(uuid()) @db.Char(36)
  publicId                     String                       @unique @db.VarChar(24)
  email                        String                       @unique
  passwordHash                 String                       @db.VarChar(255)
  fullName                     String                       @db.VarChar(160)
  displayName                  String?                      @db.VarChar(160)
  username                     String?                      @unique @db.VarChar(64)
  avatarUrl                    String?                      @db.VarChar(500)
  bio                          String?                      @db.Text
  role                         UserRole                     @default(reader)
  status                       UserStatus                   @default(active)
  emailVerified                DateTime?
  termsAcceptedAt              DateTime?
  lastLoginAt                  DateTime?
  isPremium                    Boolean                      @default(false)
  isBanned                     Boolean                      @default(false)
  deletedAt                    DateTime?
  createdAt                    DateTime                     @default(now())
  updatedAt                    DateTime                     @updatedAt
  auditLogs                    AuditLog[]                   @relation("AuditLogActor")
  feedbackReceived             EditorFeedback[]             @relation("FeedbackAuthor")
  feedbackWritten              EditorFeedback[]             @relation("FeedbackEditor")
  assignedEditorWorks          Work[]                       @relation("AssignedEditor")
  editorReviewAssignments      EditorReviewAssignment[]     @relation("EditorReviewAssignmentEditor")
  bookmarks                    Bookmark[]
  comments                     Comment[]
  editorFavorites              EditorFavorite[]
  editorInvitesAccepted        EditorInvite[]               @relation("EditorInviteAcceptedBy")
  editorInvitesSent            EditorInvite[]               @relation("EditorInviteSender")
  favorites                    Favorite[]
  readerAuthorFavoritesCreated ReaderAuthorFavorite[]       @relation("ReaderAuthorFavoriteReader")
  readerAuthorFavoritesReceived ReaderAuthorFavorite[]      @relation("ReaderAuthorFavoriteAuthor")
  recommendationsReceived      EditorRecommendation[]       @relation("EditorRecommendationRecipient")
  recommendationsSent          EditorRecommendation[]       @relation("EditorRecommendationSender")
  notifications                Notification[]
  emailVerificationTokens      EmailVerificationToken[]
  ownershipStamps              OwnershipStamp[]
  passwordResetTokens          PasswordResetToken[]
  profile                      Profile?
  publisherApplications        PublisherApplication[]
  publisherSubmissions         PublisherSubmission[]        @relation("SubmissionAuthor")
  publisherMemberships         PublisherMembership[]
  publisherPermissionRequests  PublisherPermissionRequest[] @relation("PublisherPermissionRequester")
  publisherPermissionReviews   PublisherPermissionRequest[] @relation("PublisherPermissionReviewer")
  publisherInvitationsSent     PublisherInvitation[]        @relation("PublisherInvitationSender")
  publisherInvitationsAccepted PublisherInvitation[]        @relation("PublisherInvitationAcceptedBy")
  publisherSubmissionEvents    PublisherSubmissionEvent[]   @relation("PublisherSubmissionEventActor")
  publishingContractsCreated   PublishingContract[]         @relation("PublishingContractCreator")
  publisherFilesUploaded       PublisherFile[]              @relation("PublisherFileUploader")
  reviewedRoleRequests         RoleRequest[]                @relation("RoleRequestReviewer")
  roleRequests                 RoleRequest[]                @relation("RoleRequestOwner")
  readingAccesses              ReadingAccess[]
  readingProgress              ReadingProgress[]
  sessions                     Session[]
  works                        Work[]
  authorAgreements             AuthorAgreement[]            @relation("AuthorAgreementAuthor")
  publicationConsents          WorkPublicationConsent[]     @relation("WorkPublicationConsentAuthor")
  saleConfigurations           WorkSaleConfiguration[]      @relation("WorkSaleConfigurationAuthor")
  authoredCoupons              Coupon[]                     @relation("CouponAuthor")
  couponsCreated               Coupon[]                     @relation("CouponCreator")
  couponRedemptions            CouponRedemption[]           @relation("CouponRedemptionReader")
  couponAuthorScopes           CouponAuthorScope[]          @relation("CouponAuthorScopeAuthor")
  commerceOrdersAsReader       Order[]                      @relation("OrderReader")
  commerceOrdersAsAuthor       Order[]                      @relation("OrderAuthor")
  workEntitlements             WorkEntitlement[]            @relation("WorkEntitlementReader")
  financialLedgerEntries       FinancialLedger[]            @relation("FinancialLedgerAuthor")
  authorBalances               AuthorBalance[]              @relation("AuthorBalanceAuthor")
  payouts                      Payout[]                     @relation("PayoutAuthor")
  workPriceHistory             WorkPriceHistory[]           @relation("WorkPriceHistoryAuthor")
  orderConsents                OrderConsent[]               @relation("OrderConsentReader")

  publisherWorkLikesCreated        PublisherWorkLike[]       @relation("PublisherWorkLikeCreator")
  publisherWorkFavoritesCreated    PublisherWorkFavorite[]   @relation("PublisherWorkFavoriteCreator")
  publisherAuthorLikesCreated      PublisherAuthorLike[]     @relation("PublisherAuthorLikeCreator")
  publisherAuthorLikesReceived     PublisherAuthorLike[]     @relation("PublisherAuthorLikeAuthor")
  publisherAuthorFavoritesCreated  PublisherAuthorFavorite[] @relation("PublisherAuthorFavoriteCreator")
  publisherAuthorFavoritesReceived PublisherAuthorFavorite[] @relation("PublisherAuthorFavoriteAuthor")
  publisherAuthorFollowsCreated    PublisherAuthorFollow[]   @relation("PublisherAuthorFollowCreator")
  publisherAuthorFollowsReceived   PublisherAuthorFollow[]   @relation("PublisherAuthorFollowAuthor")
  publisherDiscoverySharesCreated  PublisherDiscoveryShare[] @relation("PublisherDiscoveryShareCreator")
  publisherDiscoverySharesReceived PublisherDiscoveryShare[] @relation("PublisherDiscoveryShareAuthor")

  @@index([role])
  @@index([status])
  @@index([createdAt])
  @@index([lastLoginAt])
  @@index([deletedAt])
}

model IdentitySequence {
  id         String       @id @default(uuid()) @db.Char(36)
  type       IdentityType
  year       Int          @db.UnsignedSmallInt
  lastNumber Int          @default(0) @db.UnsignedInt
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([type, year])
  @@index([updatedAt])
}

model Profile {
  id                   String   @id @default(uuid()) @db.Char(36)
  userId               String   @unique @db.Char(36)
  website              String?  @db.VarChar(500)
  instagram            String?
  linkedin             String?  @db.VarChar(500)
  twitter              String?
  country              String?  @db.VarChar(100)
  city                 String?  @db.VarChar(100)
  birthYear            Int?
  writingGenres        String?  @db.LongText
  completionPercentage Int      @default(0) @db.UnsignedTinyInt
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([country, city])
  @@index([completionPercentage])
}

model Session {
  id              String          @id @default(uuid()) @db.Char(36)
  tokenHash       String          @unique @db.Char(64)
  userId          String          @db.Char(36)
  expiresAt       DateTime
  createdAt       DateTime        @default(now())
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  readingAccesses ReadingAccess[]

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Char(36)
  tokenHash String    @unique @db.Char(64)
  userId    String    @db.Char(36)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailDelivery {
  id                String              @id @default(uuid()) @db.Char(36)
  channel           String              @db.VarChar(32)
  deliveryMode      EmailDeliveryMode
  status            EmailDeliveryStatus @default(pending)
  fromAddress       String              @db.VarChar(320)
  fromName          String              @db.VarChar(120)
  replyTo           String              @db.VarChar(320)
  toAddress         String              @db.VarChar(320)
  subject           String              @db.VarChar(500)
  template          String              @db.VarChar(120)
  providerMessageId String?             @db.VarChar(500)
  failureCode       String?             @db.VarChar(120)
  failureMessage    String?             @db.VarChar(1000)
  attemptCount      Int                 @default(1)
  attemptedAt       DateTime            @default(now())
  sentAt            DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([status, createdAt])
  @@index([deliveryMode, createdAt])
  @@index([channel, createdAt])
  @@index([template, createdAt])
  @@index([toAddress, createdAt])
  @@index([createdAt])
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Char(36)
  tokenHash String    @unique @db.Char(64)
  userId    String    @db.Char(36)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model RoleRequest {
  id                   String                @id @default(uuid()) @db.Char(36)
  userId               String                @db.Char(36)
  requestedRole        UserRole
  status               RoleRequestStatus     @default(pending)
  pendingKey           String?               @unique @db.VarChar(96)
  reviewedById         String?               @db.Char(36)
  reviewedAt           DateTime?
  reviewNote           String?               @db.Text
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  reviewedBy           User?                 @relation("RoleRequestReviewer", fields: [reviewedById], references: [id])
  user                 User                  @relation("RoleRequestOwner", fields: [userId], references: [id], onDelete: Cascade)
  publisherApplication PublisherApplication?

  @@index([userId, status])
  @@index([requestedRole, status])
  @@index([reviewedById])
  @@index([createdAt])
}

model AuditLog {
  id         String      @id @default(uuid()) @db.Char(36)
  actorId    String?     @db.Char(36)
  action     AuditAction
  entityType String?     @db.VarChar(80)
  entityId   String?
  metadata   String?     @db.LongText
  ipAddress  String?     @db.VarChar(45)
  userAgent  String?     @db.VarChar(500)
  createdAt  DateTime    @default(now())
  actor      User?       @relation("AuditLogActor", fields: [actorId], references: [id])

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model Work {
  id                      String                   @id @default(uuid()) @db.Char(36)
  publicId                String                   @unique @db.VarChar(24)
  authorId                String                   @db.Char(36)
  title                   String                   @db.VarChar(220)
  subtitle                String?                  @db.VarChar(280)
  slug                    String                   @unique @db.VarChar(260)
  description             String?                  @db.Text
  genre                   String?                  @db.VarChar(120)
  language                String                   @default("tr") @db.VarChar(10)
  coverUrl                String?                  @db.VarChar(500)
  contentRating           WorkContentRating        @default(unrated)
  contentWarnings         String?                  @db.LongText
  contentRatingConfirmedAt DateTime?
  status                  WorkStatus               @default(draft)
  visibility              WorkVisibility           @default(private)
  isActive                Boolean                  @default(true)
  publishedAt             DateTime?
  archivedAt              DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  editorReviewStatus      EditorReviewStatus       @default(not_requested)
  editorReviewRequestedAt DateTime?
  editorReviewCompletedAt DateTime?
  assignedEditorId        String?                  @db.Char(36)
  assignedAt              DateTime?
  chapters                Chapter[]
  assignedEditor          User?                    @relation("AssignedEditor", fields: [assignedEditorId], references: [id], onDelete: SetNull)
  bookmarks               Bookmark[]
  comments                Comment[]
  editorFeedback          EditorFeedback[]
  editorFavorites         EditorFavorite[]
  editorInvites           EditorInvite[]
  editorRecommendations   EditorRecommendation[]
  editorReviewAssignments EditorReviewAssignment[]
  favorites               Favorite[]
  ownershipStamps         OwnershipStamp[]
  publisherSubmissions    PublisherSubmission[]
  readingAccesses         ReadingAccess[]
  readingProgress         ReadingProgress[]
  author                  User                     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  versions                WorkVersion[]
  saleConfiguration       WorkSaleConfiguration?
  publicationConsents     WorkPublicationConsent[]
  commerceChapterAccesses ChapterAccess[]
  couponScopes            CouponWorkScope[]
  commerceOrders          Order[]
  entitlements            WorkEntitlement[]
  financialLedgerEntries  FinancialLedger[]
  priceHistory            WorkPriceHistory[]

  publisherWorkLikes       PublisherWorkLike[]
  publisherWorkFavorites   PublisherWorkFavorite[]
  publisherDiscoveryShares PublisherDiscoveryShare[]

  @@index([authorId])
  @@index([status])
  @@index([visibility])
  @@index([isActive])
  @@index([language])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([editorReviewStatus])
  @@index([assignedEditorId, editorReviewStatus])
}

model Chapter {
  id              String            @id @default(uuid()) @db.Char(36)
  workId          String            @db.Char(36)
  authorId        String            @db.Char(36)
  title           String            @db.VarChar(220)
  content         String            @db.LongText
  position        Int
  status          ChapterStatus     @default(draft)
  publishedAt     DateTime?
  archivedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  work            Work              @relation(fields: [workId], references: [id], onDelete: Cascade)
  bookmarks       Bookmark[]
  comments        Comment[]
  editorFeedback  EditorFeedback[]
  readingAccesses ReadingAccess[]
  readingProgress ReadingProgress[]
  versions        WorkVersion[]
  commerceAccess  ChapterAccess?

  @@unique([workId, position])
  @@index([workId])
  @@index([authorId])
  @@index([status])
  @@index([updatedAt])
}

model Favorite {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @db.Char(36)
  workId    String   @db.Char(36)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  work      Work     @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@unique([userId, workId])
  @@index([userId, createdAt])
  @@index([workId])
}

model ReaderAuthorFavorite {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @db.Char(36)
  authorId  String   @db.Char(36)
  createdAt DateTime @default(now())
  user      User     @relation("ReaderAuthorFavoriteReader", fields: [userId], references: [id], onDelete: Cascade)
  author    User     @relation("ReaderAuthorFavoriteAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([userId, authorId])
  @@index([userId, createdAt])
  @@index([authorId, createdAt])
}

model ReadingProgress {
  id              String    @id @default(uuid()) @db.Char(36)
  userId          String    @db.Char(36)
  workId          String    @db.Char(36)
  chapterId       String    @db.Char(36)
  progressPercent Int       @default(0) @db.UnsignedTinyInt
  lastPosition    Int?      @db.UnsignedInt
  completed       Boolean   @default(false)
  startedAt       DateTime  @default(now())
  lastReadAt      DateTime  @default(now())
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  work            Work      @relation(fields: [workId], references: [id], onDelete: Cascade)
  chapter         Chapter   @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, workId])
  @@index([userId, lastReadAt])
  @@index([workId])
  @@index([chapterId])
  @@index([completed, lastReadAt])
}

model ReadingAccess {
  id            String             @id @default(uuid()) @db.Char(36)
  dedupeKey     String             @unique @db.Char(64)
  userId        String             @db.Char(36)
  sessionId     String?            @db.Char(36)
  workId        String             @db.Char(36)
  chapterId     String             @db.Char(36)
  ipHash        String?            @db.Char(64)
  userAgentHash String?            @db.Char(64)
  deviceClass   ReadingDeviceClass @default(unknown)
  riskLevel     ReadingAccessRisk  @default(normal)
  riskScore     Int                @default(0) @db.UnsignedTinyInt
  riskFlags     String?            @db.VarChar(500)
  ruleVersion   Int                @default(1) @db.UnsignedSmallInt
  viewCount     Int                @default(1) @db.UnsignedInt
  openedAt      DateTime           @default(now())
  lastSeenAt    DateTime           @default(now())
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  session       Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  work          Work               @relation(fields: [workId], references: [id], onDelete: Cascade)
  chapter       Chapter            @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([userId, lastSeenAt])
  @@index([workId, lastSeenAt])
  @@index([chapterId, lastSeenAt])
  @@index([sessionId, lastSeenAt])
  @@index([riskLevel, lastSeenAt])
  @@index([ipHash, lastSeenAt])
  @@index([userAgentHash, lastSeenAt])
  @@index([lastSeenAt])
}

model Bookmark {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @db.Char(36)
  workId    String   @db.Char(36)
  chapterId String   @db.Char(36)
  position  Int      @db.UnsignedInt
  label     String?  @db.VarChar(160)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  work      Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterId, position])
  @@index([userId, updatedAt])
  @@index([workId])
  @@index([chapterId])
}

model Comment {
  id        String        @id @default(uuid()) @db.Char(36)
  publicId  String        @unique @db.VarChar(24)
  userId    String        @db.Char(36)
  workId    String        @db.Char(36)
  chapterId String?       @db.Char(36)
  parentId  String?       @db.Char(36)
  content   String        @db.Text
  status    CommentStatus @default(visible)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  editedAt  DateTime?
  deletedAt DateTime?
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  work      Work          @relation(fields: [workId], references: [id], onDelete: Cascade)
  chapter   Chapter?      @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  parent    Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies   Comment[]     @relation("CommentReplies")

  @@index([userId, createdAt])
  @@index([workId, status, createdAt])
  @@index([chapterId, status, createdAt])
  @@index([parentId, createdAt])
  @@index([deletedAt])
}

model WorkVersion {
  id            String   @id @default(uuid()) @db.Char(36)
  workId        String   @db.Char(36)
  chapterId     String?  @db.Char(36)
  versionNumber Int
  title         String?  @db.VarChar(220)
  subtitle      String?  @db.VarChar(280)
  description   String?  @db.Text
  content       String?  @db.LongText
  contentHash   String   @db.VarChar(128)
  createdAt     DateTime @default(now())
  chapter       Chapter? @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  work          Work     @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@unique([workId, versionNumber])
  @@index([workId])
  @@index([chapterId])
  @@index([createdAt])
}

model OwnershipStamp {
  id          String               @id @default(uuid()) @db.Char(36)
  workId      String               @db.Char(36)
  authorId    String               @db.Char(36)
  stampCode   String               @unique @db.VarChar(100)
  contentHash String               @db.VarChar(128)
  version     Int                  @default(1)
  status      OwnershipStampStatus @default(active)
  stampedAt   DateTime             @default(now())
  revokedAt   DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  author      User                 @relation(fields: [authorId], references: [id], onDelete: Cascade)
  work        Work                 @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@index([workId])
  @@index([authorId])
  @@index([status])
  @@index([stampedAt])
}

model EditorFeedback {
  id                   String                  @id @default(uuid()) @db.Char(36)
  workId               String                  @db.Char(36)
  chapterId            String?                 @db.Char(36)
  editorId             String                  @db.Char(36)
  authorId             String                  @db.Char(36)
  title                String                  @db.VarChar(160)
  content              String                  @db.LongText
  category             String                  @db.VarChar(60)
  status               FeedbackStatus          @default(unread)
  priority             FeedbackPriority        @default(normal)
  isProfessionalReview Boolean                 @default(false)
  reportStatus         EditorReportStatus      @default(completed)
  readAt               DateTime?
  archivedAt           DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  author               User                    @relation("FeedbackAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  chapter              Chapter?                @relation(fields: [chapterId], references: [id])
  editor               User                    @relation("FeedbackEditor", fields: [editorId], references: [id])
  assignmentId         String?                 @db.Char(36)
  assignment           EditorReviewAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  work                 Work                    @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@index([authorId, status, createdAt])
  @@index([editorId, createdAt])
  @@index([workId])
  @@index([workId, editorId, isProfessionalReview])
  @@index([workId, reportStatus])
  @@index([chapterId])
  @@index([assignmentId])
}

model EditorReviewAssignment {
  id           String                 @id @default(uuid()) @db.Char(36)
  workId       String                 @db.Char(36)
  editorId     String?                @db.Char(36)
  stage        EditorReviewStage
  source       EditorAssignmentSource
  status       EditorAssignmentStatus @default(waiting)
  invitedEmail String?                @db.VarChar(320)
  assignedAt   DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  work         Work                   @relation(fields: [workId], references: [id], onDelete: Cascade)
  editor       User?                  @relation("EditorReviewAssignmentEditor", fields: [editorId], references: [id], onDelete: SetNull)
  feedback     EditorFeedback[]

  @@unique([workId, stage])
  @@index([editorId, status])
  @@index([stage, status, createdAt])
  @@index([invitedEmail, status])
}

model EditorFavorite {
  id        String   @id @default(uuid()) @db.Char(36)
  editorId  String   @db.Char(36)
  workId    String   @db.Char(36)
  createdAt DateTime @default(now())
  editor    User     @relation(fields: [editorId], references: [id], onDelete: Cascade)
  work      Work     @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@unique([editorId, workId])
  @@index([workId])
  @@index([createdAt])
}

model EditorRecommendation {
  id                String                     @id @default(uuid()) @db.Char(36)
  workId            String                     @db.Char(36)
  senderEditorId    String                     @db.Char(36)
  recipientEditorId String                     @db.Char(36)
  status            EditorRecommendationStatus @default(pending)
  viewedAt          DateTime?
  createdAt         DateTime                   @default(now())
  senderEditor      User                       @relation("EditorRecommendationSender", fields: [senderEditorId], references: [id], onDelete: Cascade)
  recipientEditor   User                       @relation("EditorRecommendationRecipient", fields: [recipientEditorId], references: [id], onDelete: Cascade)
  work              Work                       @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@unique([senderEditorId, recipientEditorId, workId])
  @@index([recipientEditorId, status, createdAt])
  @@index([workId])
}

model EditorInvite {
  id           String    @id @default(uuid()) @db.Char(36)
  workId       String    @db.Char(36)
  invitedById  String    @db.Char(36)
  invitedEmail String    @db.VarChar(320)
  tokenHash    String    @unique @db.Char(64)
  expiresAt    DateTime
  usedAt       DateTime?
  acceptedById String?   @db.Char(36)
  createdAt    DateTime  @default(now())
  invitedBy    User      @relation("EditorInviteSender", fields: [invitedById], references: [id], onDelete: Cascade)
  acceptedBy   User?     @relation("EditorInviteAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)
  work         Work      @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@unique([workId, invitedEmail])
  @@index([invitedById, createdAt])
  @@index([invitedEmail])
  @@index([expiresAt])
}

model Notification {
  id                String           @id @default(uuid()) @db.Char(36)
  userId            String           @db.Char(36)
  type              NotificationType
  title             String           @db.VarChar(160)
  message           String           @db.VarChar(500)
  relatedEntityType String?          @db.VarChar(80)
  relatedEntityId   String?          @db.Char(36)
  readAt            DateTime?
  createdAt         DateTime         @default(now())
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([relatedEntityType, relatedEntityId])
}

model Publisher {
  id                    String                       @id @default(uuid()) @db.Char(36)
  publicId              String                       @unique @db.VarChar(24)
  companyName           String                       @db.VarChar(220)
  legalCompanyName      String?                      @db.VarChar(240)
  companyType           String?                      @db.VarChar(80)
  establishmentYear     Int?                         @db.UnsignedSmallInt
  taxOffice             String?                      @db.VarChar(160)
  taxNumber             String?                      @db.VarChar(32)
  registryNumber        String?                      @db.VarChar(64)
  address               String?                      @db.Text
  city                  String?                      @db.VarChar(120)
  district              String?                      @db.VarChar(120)
  corporatePhone        String?                      @db.VarChar(32)
  corporateEmail        String?                      @db.VarChar(320)
  publicationCategories String?                      @db.LongText
  slug                  String                       @unique @db.VarChar(220)
  description           String?                      @db.Text
  websiteUrl            String?                      @db.VarChar(500)
  logoUrl               String?                      @db.VarChar(500)
  verified              Boolean                      @default(false)
  acceptsSubmissions    Boolean                      @default(true)
  active                Boolean                      @default(true)
  archivedAt            DateTime?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  submissions           PublisherSubmission[]
  members               PublisherMembership[]
  invitations           PublisherInvitation[]
  applications          PublisherApplication[]
  permissionRequests    PublisherPermissionRequest[]

  workLikes       PublisherWorkLike[]
  workFavorites   PublisherWorkFavorite[]
  authorLikes     PublisherAuthorLike[]
  authorFavorites PublisherAuthorFavorite[]
  authorFollows   PublisherAuthorFollow[]
  discoveryShares PublisherDiscoveryShare[]

  @@index([active, verified, archivedAt])
  @@index([companyName])
}

model PublisherApplication {
  id                        String                     @id @default(uuid()) @db.Char(36)
  roleRequestId             String                     @unique @db.Char(36)
  applicantUserId           String                     @db.Char(36)
  publisherId               String?                    @db.Char(36)
  publisherName             String                     @db.VarChar(220)
  legalCompanyName          String                     @db.VarChar(240)
  companyType               String                     @db.VarChar(80)
  establishmentYear         Int                        @db.UnsignedSmallInt
  taxOffice                 String                     @db.VarChar(160)
  taxNumber                 String                     @db.VarChar(32)
  mersisOrRegistryNumber    String                     @db.VarChar(64)
  address                   String                     @db.Text
  city                      String                     @db.VarChar(120)
  district                  String                     @db.VarChar(120)
  corporatePhone            String                     @db.VarChar(32)
  corporateEmail            String                     @db.VarChar(320)
  websiteUrl                String?                    @db.VarChar(500)
  authorizedPersonFirstName String                     @db.VarChar(100)
  authorizedPersonLastName  String                     @db.VarChar(100)
  authorizedPersonTitle     String                     @db.VarChar(160)
  authorizedPersonPhone     String                     @db.VarChar(32)
  authorizedPersonEmail     String                     @db.VarChar(320)
  logoUrl                   String?                    @db.VarChar(500)
  description               String                     @db.Text
  publicationCategories     String                     @db.LongText
  acceptsSubmissions        Boolean                    @default(true)
  verificationDocumentUrls  String                     @db.LongText
  verificationStatus        PublisherApplicationStatus @default(submitted)
  correctionNote            String?                    @db.Text
  submittedAt               DateTime?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  applicant                 User                       @relation(fields: [applicantUserId], references: [id], onDelete: Cascade)
  publisher                 Publisher?                 @relation(fields: [publisherId], references: [id], onDelete: SetNull)
  roleRequest               RoleRequest                @relation(fields: [roleRequestId], references: [id], onDelete: Cascade)

  @@index([applicantUserId, verificationStatus])
  @@index([publisherId])
  @@index([verificationStatus, submittedAt])
}

model PublisherMembership {
  id                  String                       @id @default(uuid()) @db.Char(36)
  publisherId         String                       @db.Char(36)
  userId              String                       @db.Char(36)
  role                PublisherMemberRole          @default(reviewer)
  active              Boolean                      @default(true)
  permissionOverrides Json?
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  publisher           Publisher                    @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  user                User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionRequests  PublisherPermissionRequest[]

  discoveryShareRecipients PublisherDiscoveryShareRecipient[]

  @@unique([publisherId, userId])
  @@index([userId, active])
  @@index([publisherId, active])
}

model PublisherInvitation {
  id                  String                    @id @default(uuid()) @db.Char(36)
  publisherId         String                    @db.Char(36)
  invitedById         String                    @db.Char(36)
  invitedEmail        String                    @db.VarChar(320)
  role                PublisherMemberRole       @default(reviewer)
  permissionOverrides Json?
  tokenHash           String                    @unique @db.Char(64)
  status              PublisherInvitationStatus @default(pending)
  expiresAt           DateTime
  acceptedAt          DateTime?
  declinedAt          DateTime?
  cancelledAt         DateTime?
  acceptedById        String?                   @db.Char(36)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  publisher  Publisher @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  invitedBy  User      @relation("PublisherInvitationSender", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptedBy User?     @relation("PublisherInvitationAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([publisherId, status, createdAt])
  @@index([publisherId, invitedEmail, status])
  @@index([invitedEmail, status])
  @@index([invitedById, createdAt])
  @@index([expiresAt, status])
}

model PublisherSubmission {
  id              String                     @id @default(uuid()) @db.Char(36)
  publisherId     String                     @db.Char(36)
  workId          String                     @db.Char(36)
  authorId        String                     @db.Char(36)
  coverLetter     String                     @db.Text
  publisherNote   String?                    @db.Text
  status          PublisherSubmissionStatus  @default(pending)
  submittedAt     DateTime                   @default(now())
  archivedAt      DateTime?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  author          User                       @relation("SubmissionAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  publisher       Publisher                  @relation(fields: [publisherId], references: [id])
  work            Work                       @relation(fields: [workId], references: [id], onDelete: Cascade)
  events          PublisherSubmissionEvent[]
  contract        PublishingContract?
  publicationPlan PublicationPlan?
  files           PublisherFile[]

  @@unique([authorId, publisherId, workId, archivedAt])
  @@index([authorId, status, updatedAt])
  @@index([publisherId, status])
  @@index([workId])
}

model PublishingContract {
  id                 String                   @id @default(uuid()) @db.Char(36)
  submissionId       String                   @unique @db.Char(36)
  createdById        String                   @db.Char(36)
  status             PublishingContractStatus @default(draft)
  version            Int                      @default(1) @db.UnsignedInt
  royaltyPercentage  Decimal                  @db.Decimal(5, 2)
  advanceAmount      Decimal?                 @db.Decimal(12, 2)
  rightsPeriodMonths Int                      @default(60) @db.UnsignedSmallInt
  territory          String                   @default("Türkiye") @db.VarChar(180)
  notes              String?                  @db.Text
  sentAt             DateTime?
  acceptedAt         DateTime?
  rejectedAt         DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  submission         PublisherSubmission      @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  createdBy          User                     @relation("PublishingContractCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([status, updatedAt])
  @@index([createdById, createdAt])
}

model PublicationPlan {
  id                    String                @id @default(uuid()) @db.Char(36)
  submissionId          String                @unique @db.Char(36)
  status                PublicationPlanStatus @default(planning)
  targetPublicationDate DateTime?
  isbn                  String?               @db.VarChar(32)
  coverStatus           ProductionTaskStatus  @default(not_started)
  layoutStatus          ProductionTaskStatus  @default(not_started)
  printRun              Int?                  @db.UnsignedInt
  notes                 String?               @db.Text
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  submission            PublisherSubmission   @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([status, targetPublicationDate])
}

model PublisherSubmissionEvent {
  id           String                       @id @default(uuid()) @db.Char(36)
  submissionId String                       @db.Char(36)
  actorId      String?                      @db.Char(36)
  type         PublisherSubmissionEventType
  title        String                       @db.VarChar(180)
  detail       String?                      @db.Text
  metadata     String?                      @db.LongText
  createdAt    DateTime                     @default(now())
  submission   PublisherSubmission          @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  actor        User?                        @relation("PublisherSubmissionEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([submissionId, createdAt])
  @@index([actorId, createdAt])
  @@index([type, createdAt])
}

model PublisherFile {
  id           String                @id @default(uuid()) @db.Char(36)
  submissionId String                @db.Char(36)
  uploadedById String?               @db.Char(36)
  category     PublisherFileCategory
  fileName     String                @db.VarChar(255)
  mimeType     String                @db.VarChar(160)
  sizeBytes    BigInt                @db.UnsignedBigInt
  storageUrl   String                @db.VarChar(1000)
  createdAt    DateTime              @default(now())
  archivedAt   DateTime?
  submission   PublisherSubmission   @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  uploadedBy   User?                 @relation("PublisherFileUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([submissionId, category, createdAt])
  @@index([uploadedById, createdAt])
  @@index([archivedAt])
}


// -----------------------------------------------------------------------------
// Commerce foundation (v1)
// Model is intentionally provider-agnostic. Real card/carrier integrations are
// attached later without changing author/reader access semantics.
// -----------------------------------------------------------------------------

model AuthorAgreement {
  id               String          @id @default(uuid()) @db.Char(36)
  authorId         String          @db.Char(36)
  agreementType    AgreementType   @default(author_publication_access)
  agreementVersion String          @db.VarChar(40)
  documentHash     String          @db.Char(64)
  status           AgreementStatus @default(accepted)
  acceptedAt       DateTime        @default(now())
  revokedAt        DateTime?
  ipAddress        String?         @db.VarChar(45)
  userAgent        String?         @db.VarChar(500)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  author           User            @relation("AuthorAgreementAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([authorId, agreementType, agreementVersion])
  @@index([authorId, status, acceptedAt])
}

model WorkPublicationConsent {
  id                 String           @id @default(uuid()) @db.Char(36)
  workId             String           @db.Char(36)
  authorId           String           @db.Char(36)
  publicationModel   PublicationModel
  priceAmount        BigInt?          @db.UnsignedBigInt
  currency           String           @default("TRY") @db.Char(3)
  accessPlanSnapshot Json
  agreementVersion   String           @db.VarChar(40)
  confirmedAt        DateTime         @default(now())
  createdAt          DateTime         @default(now())
  work               Work             @relation(fields: [workId], references: [id], onDelete: Cascade)
  author             User             @relation("WorkPublicationConsentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([workId, confirmedAt])
  @@index([authorId, confirmedAt])
}

model WorkSaleConfiguration {
  id               String           @id @default(uuid()) @db.Char(36)
  workId           String           @unique @db.Char(36)
  authorId         String           @db.Char(36)
  saleModel        PublicationModel @default(free)
  priceAmount      BigInt?          @db.UnsignedBigInt
  currency         String           @default("TRY") @db.Char(3)
  status           WorkSaleStatus   @default(draft)
  agreementVersion String?          @db.VarChar(40)
  confirmedAt      DateTime?
  activatedAt      DateTime?
  pausedAt         DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  work             Work             @relation(fields: [workId], references: [id], onDelete: Cascade)
  author           User             @relation("WorkSaleConfigurationAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId, status])
  @@index([saleModel, status])
}

model ChapterAccess {
  id         String            @id @default(uuid()) @db.Char(36)
  chapterId  String            @unique @db.Char(36)
  workId     String            @db.Char(36)
  accessType ChapterAccessType @default(preview)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  chapter    Chapter           @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  work       Work              @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@index([workId, accessType])
}

model WorkPriceHistory {
  id         String   @id @default(uuid()) @db.Char(36)
  workId     String   @db.Char(36)
  authorId   String   @db.Char(36)
  oldPrice   BigInt?  @db.UnsignedBigInt
  newPrice   BigInt?  @db.UnsignedBigInt
  currency   String   @default("TRY") @db.Char(3)
  changedAt  DateTime @default(now())
  work       Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  author     User     @relation("WorkPriceHistoryAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([workId, changedAt])
  @@index([authorId, changedAt])
}

model Coupon {
  id                    String             @id @default(uuid()) @db.Char(36)
  code                  String             @unique @db.VarChar(64)
  owner                 CouponOwner
  authorId              String?            @db.Char(36)
  creatorId             String?            @db.Char(36)
  discountType          CouponDiscountType
  discountValue         BigInt             @db.UnsignedBigInt
  scope                 CouponScope
  status                CouponStatus       @default(draft)
  startsAt              DateTime?
  endsAt                DateTime?
  totalUsageLimit       Int?               @db.UnsignedInt
  perUserUsageLimit     Int                @default(1) @db.UnsignedSmallInt
  usageCount            Int                @default(0) @db.UnsignedInt
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  author                User?              @relation("CouponAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  creator               User?              @relation("CouponCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  workScopes            CouponWorkScope[]
  authorScopes          CouponAuthorScope[]
  redemptions           CouponRedemption[]
  orders                Order[]
  financialLedgerEntries FinancialLedger[]

  @@index([owner, status])
  @@index([authorId, status])
  @@index([startsAt, endsAt])
}

model CouponWorkScope {
  id        String   @id @default(uuid()) @db.Char(36)
  couponId  String   @db.Char(36)
  workId    String   @db.Char(36)
  createdAt DateTime @default(now())
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  work      Work     @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@unique([couponId, workId])
  @@index([workId])
}

model CouponAuthorScope {
  id        String   @id @default(uuid()) @db.Char(36)
  couponId  String   @db.Char(36)
  authorId  String   @db.Char(36)
  createdAt DateTime @default(now())
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  author    User     @relation("CouponAuthorScopeAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([couponId, authorId])
  @@index([authorId])
}

model CouponRedemption {
  id             String                 @id @default(uuid()) @db.Char(36)
  couponId       String                 @db.Char(36)
  readerId       String                 @db.Char(36)
  orderId        String                 @unique @db.Char(36)
  discountAmount BigInt                 @db.UnsignedBigInt
  status         CouponRedemptionStatus @default(reserved)
  reservedAt     DateTime               @default(now())
  redeemedAt     DateTime?
  releasedAt     DateTime?
  coupon         Coupon                 @relation(fields: [couponId], references: [id], onDelete: Restrict)
  reader         User                   @relation("CouponRedemptionReader", fields: [readerId], references: [id], onDelete: Cascade)
  order          Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId, status, reservedAt])
  @@index([readerId, status, reservedAt])
}

model Order {
  id                      String              @id @default(uuid()) @db.Char(36)
  orderNo                 String              @unique @db.VarChar(40)
  readerId                String              @db.Char(36)
  workId                  String              @db.Char(36)
  authorId                String              @db.Char(36)
  couponId                String?             @db.Char(36)
  originalAmount          BigInt              @db.UnsignedBigInt
  discountAmount          BigInt              @default(0) @db.UnsignedBigInt
  finalAmount             BigInt              @db.UnsignedBigInt
  authorEarningBaseAmount BigInt              @db.UnsignedBigInt
  currency                String              @default("TRY") @db.Char(3)
  couponCodeSnapshot      String?             @db.VarChar(64)
  couponOwnerSnapshot     CouponOwner?
  discountTypeSnapshot    CouponDiscountType?
  discountValueSnapshot   BigInt?             @db.UnsignedBigInt
  status                  OrderStatus         @default(draft)
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  paidAt                  DateTime?
  cancelledAt             DateTime?
  refundedAt              DateTime?
  reader                   User                @relation("OrderReader", fields: [readerId], references: [id], onDelete: Restrict)
  author                   User                @relation("OrderAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  work                     Work                @relation(fields: [workId], references: [id], onDelete: Restrict)
  coupon                   Coupon?             @relation(fields: [couponId], references: [id], onDelete: SetNull)
  payments                 Payment[]
  entitlement              WorkEntitlement?
  couponRedemption         CouponRedemption?
  refunds                  Refund[]
  financialLedgerEntries   FinancialLedger[]
  consent                  OrderConsent?

  @@index([readerId, createdAt])
  @@index([authorId, createdAt])
  @@index([workId, createdAt])
  @@index([status, createdAt])
  @@index([couponId, createdAt])
}

model OrderConsent {
  id              String           @id @default(uuid()) @db.Char(36)
  orderId         String           @unique @db.Char(36)
  readerId        String           @db.Char(36)
  consentType     OrderConsentType @default(digital_content_purchase)
  documentVersion String           @db.VarChar(40)
  documentHash    String           @db.Char(64)
  acceptedAt      DateTime         @default(now())
  ipAddress       String?          @db.VarChar(45)
  userAgent       String?          @db.VarChar(500)
  createdAt       DateTime         @default(now())
  order           Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reader          User             @relation("OrderConsentReader", fields: [readerId], references: [id], onDelete: Restrict)

  @@index([readerId, acceptedAt])
  @@index([consentType, acceptedAt])
}

model Payment {
  id                    String        @id @default(uuid()) @db.Char(36)
  orderId               String        @db.Char(36)
  method                PaymentMethod
  provider              String        @db.VarChar(80)
  providerTransactionId String?       @db.VarChar(160)
  amount                BigInt        @db.UnsignedBigInt
  currency              String        @default("TRY") @db.Char(3)
  status                PaymentStatus @default(pending)
  failureCode           String?       @db.VarChar(80)
  failureMessage        String?       @db.VarChar(500)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  completedAt           DateTime?
  order                 Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds               Refund[]

  @@index([orderId, createdAt])
  @@unique([provider, providerTransactionId])
  @@index([status, createdAt])
}

model WorkEntitlement {
  id        String            @id @default(uuid()) @db.Char(36)
  readerId  String            @db.Char(36)
  workId    String            @db.Char(36)
  orderId   String?           @unique @db.Char(36)
  source    EntitlementSource
  status    EntitlementStatus @default(active)
  grantedAt DateTime          @default(now())
  revokedAt DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  reader    User              @relation("WorkEntitlementReader", fields: [readerId], references: [id], onDelete: Cascade)
  work      Work              @relation(fields: [workId], references: [id], onDelete: Cascade)
  order     Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([readerId, workId])
  @@index([workId, status])
  @@index([readerId, status])
}

model FinancialLedger {
  id             String          @id @default(uuid()) @db.Char(36)
  idempotencyKey String          @unique @db.VarChar(120)
  entryType      LedgerEntryType
  amount         BigInt
  currency       String          @default("TRY") @db.Char(3)
  orderId        String?         @db.Char(36)
  workId         String?         @db.Char(36)
  authorId       String?         @db.Char(36)
  couponId       String?         @db.Char(36)
  payoutId       String?         @db.Char(36)
  metadata       Json?
  createdAt      DateTime        @default(now())
  order          Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  work           Work?           @relation(fields: [workId], references: [id], onDelete: SetNull)
  author         User?           @relation("FinancialLedgerAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  coupon         Coupon?         @relation(fields: [couponId], references: [id], onDelete: SetNull)
  payout         Payout?         @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([entryType, createdAt])
  @@index([orderId, createdAt])
  @@index([authorId, createdAt])
  @@index([workId, createdAt])
  @@index([payoutId, createdAt])
}

model AuthorBalance {
  id               String   @id @default(uuid()) @db.Char(36)
  authorId         String   @db.Char(36)
  currency         String   @default("TRY") @db.Char(3)
  pendingAmount    BigInt   @default(0)
  availableAmount  BigInt   @default(0)
  processingAmount BigInt   @default(0)
  paidAmount       BigInt   @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  author           User     @relation("AuthorBalanceAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([authorId, currency])
  @@index([updatedAt])
}

model Payout {
  id          String       @id @default(uuid()) @db.Char(36)
  authorId    String       @db.Char(36)
  amount      BigInt       @db.UnsignedBigInt
  currency    String       @default("TRY") @db.Char(3)
  status      PayoutStatus @default(pending)
  periodStart DateTime?
  periodEnd   DateTime?
  method      String?      @db.VarChar(80)
  reference   String?      @db.VarChar(160)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  paidAt      DateTime?
  author      User         @relation("PayoutAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  ledgerEntries FinancialLedger[]

  @@index([authorId, status, createdAt])
  @@index([status, createdAt])
}

model Refund {
  id          String       @id @default(uuid()) @db.Char(36)
  orderId     String       @db.Char(36)
  paymentId   String?      @db.Char(36)
  amount      BigInt       @db.UnsignedBigInt
  currency    String       @default("TRY") @db.Char(3)
  status      RefundStatus @default(requested)
  reason      String?      @db.VarChar(500)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  processedAt DateTime?
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment     Payment?     @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([paymentId, createdAt])
  @@index([status, createdAt])
}

enum OrderConsentType {
  digital_content_purchase
}

enum PublicationModel {
  free
  paid
}

enum WorkSaleStatus {
  draft
  ready
  active
  paused
}

enum ChapterAccessType {
  preview
  locked
}

enum AgreementType {
  author_publication_access
}

enum AgreementStatus {
  accepted
  revoked
  superseded
}

enum CouponOwner {
  author
  platform
}

enum CouponDiscountType {
  percent
  fixed
}

enum CouponScope {
  selected_works
  all_paid_works
  selected_authors
}

enum CouponStatus {
  draft
  active
  paused
  expired
}

enum CouponRedemptionStatus {
  reserved
  used
  released
  refunded
}

enum OrderStatus {
  draft
  pending_payment
  paid
  failed
  cancelled
  refunded
}

enum PaymentMethod {
  test
  card
  carrier
}

enum PaymentStatus {
  pending
  succeeded
  failed
  cancelled
  refunded
}

enum EntitlementSource {
  purchase
  coupon
  admin
  promotion
}

enum EntitlementStatus {
  active

.chapter-management-panel {
  display: grid;
  gap: 1.5rem;
  margin-top: 2rem;
  padding: 1.5rem;
  border: 1px solid var(--color-border, #e5e7eb);
  border-radius: 1.25rem;
  background: var(--color-surface, #ffffff);
  box-shadow: 0 1rem 3rem rgba(15, 23, 42, 0.06);
}

.chapter-management-panel__heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 1rem;
}

.chapter-management-panel__heading p {
  margin: 0 0 0.35rem;
  color: var(--color-primary, #6d28d9);
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.chapter-management-panel__heading h2 {
  margin: 0;
  color: var(--color-text, #111827);
  font-size: clamp(1.25rem, 2vw, 1.65rem);
  line-height: 1.25;
}

.chapter-management-panel__heading > span {
  flex: 0 0 auto;
  padding: 0.45rem 0.75rem;
  border-radius: 999px;
  background: rgba(109, 40, 217, 0.08);
  color: var(--color-primary, #6d28d9);
  font-size: 0.75rem;
  font-weight: 800;
}

.chapter-management-panel__list {
  display: grid;
  gap: 0.85rem;
}

.chapter-management-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  min-width: 0;
  padding: 1rem;
  border: 1px solid var(--color-border, #e5e7eb);
  border-radius: 1rem;
  background: #ffffff;
  transition:
    border-color 160ms ease,
    box-shadow 160ms ease,
    transform 160ms ease;
}

.chapter-management-card:hover {
  transform: translateY(-1px);
  border-color: rgba(109, 40, 217, 0.28);
  box-shadow: 0 0.75rem 2rem rgba(15, 23, 42, 0.06);
}

.chapter-management-card__summary {
  display: flex;
  align-items: center;
  gap: 0.85rem;
  min-width: 0;
}

.chapter-management-card__summary > span {
  display: grid;
  flex: 0 0 2.5rem;
  width: 2.5rem;
  height: 2.5rem;
  place-items: center;
  border-radius: 0.8rem;
  background: rgba(109, 40, 217, 0.09);
  color: var(--color-primary, #6d28d9);
  font-size: 0.85rem;
  font-weight: 900;
}

.chapter-management-card__summary > div {
  display: grid;
  gap: 0.22rem;
  min-width: 0;
}

.chapter-management-card__summary strong {
  display: block;
  overflow: hidden;
  color: var(--color-text, #111827);
  font-size: 0.95rem;
  font-weight: 800;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chapter-management-card__summary small {
  display: block;
  color: var(--color-text-secondary, #6b7280);
  font-size: 0.75rem;
}

.chapter-management-card__actions {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 0.65rem;
}

.chapter-management-card__actions form {
  margin: 0;
}

.chapter-management-card__actions button,
.chapter-management-card__actions summary {
  display: inline-flex;
  min-height: 2.35rem;
  align-items: center;
  justify-content: center;
  padding: 0 0.8rem;
  border: 1px solid var(--color-border, #e5e7eb);
  border-radius: 0.7rem;
  background: #ffffff;
  color: var(--color-text, #111827);
  font: inherit;
  font-size: 0.72rem;
  font-weight: 800;
  cursor: pointer;
  transition:
    background 160ms ease,
    border-color 160ms ease,
    color 160ms ease;
}

.chapter-management-card__actions button:hover,
.chapter-management-card__actions summary:hover {
  border-color: rgba(109, 40, 217, 0.3);
  background: rgba(109, 40, 217, 0.05);
  color: var(--color-primary, #6d28d9);
}

.chapter-management-card__actions .chapter-danger-action {
  border-color: rgba(220, 38, 38, 0.2);
  background: rgba(220, 38, 38, 0.05);
  color: #b91c1c;
}

.chapter-management-card__actions .chapter-danger-action:hover {
  border-color: rgba(220, 38, 38, 0.35);
  background: rgba(220, 38, 38, 0.1);
  color: #991b1b;
}

.chapter-management-card__actions details {
  position: relative;
}

.chapter-management-card__actions summary {
  list-style: none;
}

.chapter-management-card__actions summary::-webkit-details-marker {
  display: none;
}

.chapter-version-list {
  position: absolute;
  top: calc(100% + 0.5rem);
  right: 0;
  z-index: 20;
  width: min(23rem, 80vw);
  max-height: 20rem;
  overflow-y: auto;
  padding: 0.75rem;
  border: 1px solid var(--color-border, #e5e7eb);
  border-radius: 0.9rem;
  background: #ffffff;
  box-shadow: 0 1rem 3rem rgba(15, 23, 42, 0.14);
}

.chapter-version-list > p {
  margin: 0;
  padding: 0.75rem;
  color: var(--color-text-secondary, #6b7280);
  font-size: 0.75rem;
  text-align: center;
}

.chapter-version-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  padding: 0.7rem;
  border-radius: 0.7rem;
}

.chapter-version-row + .chapter-version-row {
  border-top: 1px solid var(--color-border, #e5e7eb);
}

.chapter-version-row > div {
  display: grid;
  gap: 0.15rem;
}

.chapter-version-row strong {
  color: var(--color-text, #111827);
  font-size: 0.78rem;
}

.chapter-version-row small {
  color: var(--color-text-secondary, #6b7280);
  font-size: 0.68rem;
}

@media (max-width: 760px) {
  .chapter-management-panel {
    padding: 1rem;
  }

  .chapter-management-panel__heading {
    align-items: flex-start;
    flex-direction: column;
  }

  .chapter-management-card {
    align-items: stretch;
    flex-direction: column;
  }

  .chapter-management-card__actions {
    width: 100%;
    flex-wrap: wrap;
  }

  .chapter-management-card__actions form,
  .chapter-management-card__actions details {
    flex: 1;
  }

  .chapter-management-card__actions button,
  .chapter-management-card__actions summary {
    width: 100%;
  }

  .chapter-version-list {
    right: auto;
    left: 0;
  }
}
